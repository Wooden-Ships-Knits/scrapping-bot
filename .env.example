# Copy to .env and fill in. .env is gitignored; never commit real keys.
# LLM provider keys (used from M3; leave empty until then)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Store discovery (scrapebot discover). A source without its key is skipped.
# Google Maps: a Google Cloud key with "Places API (New)" enabled.
GOOGLE_MAPS_API_KEY=
# Web search, Instagram / Facebook search and website lookup.
TAVILY_API_KEY=
# Traffic on our own Shopify store (web app, "Traffic toko"; ADR 0009). The app needs
# the read_reports scope. Client ID + secret from the Dev Dashboard are preferred; a
# fixed Admin API token (shpat_...) works too.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
